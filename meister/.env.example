# 문의 폼 전송 엔드포인트 (Formspree / Web3Forms / Getform 등 JSON POST를 받는 주소)
# 비워두면 '데모 모드'로 동작합니다: 화면 검증은 되지만 실제 전송 대신 메일 앱 열기를 안내합니다.
VITE_FORM_ENDPOINT=

# 공개 전 검토용 디자인 방향 전환 패널 (true/false)
VITE_SHOW_DIRECTION_SWITCHER=true

# 배포 기준 경로. GitHub Pages 프로젝트 페이지는 /<repo>/, 커스텀 도메인은 /
BASE_PATH=/merister/

# 사이트 절대 주소 (canonical, sitemap, OG 태그용)
SITE_URL=https://merlin-not-droid.github.io/merister
